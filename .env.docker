# Docker-specific environment variables
APP_DEBUG=0

# Domain for Caddy Docker Proxy
DOMAIN=partsdb.l.supported.systems

# ===== PRODUCTION CHANGES REQUIRED =====
# 1. Admin password - CHANGE THIS IMMEDIATELY!
INITIAL_ADMIN_PW=admin123

# 2. Application secret - GENERATE A SECURE ONE!
#    Run: openssl rand -hex 32
#    Replace the value below with the generated string
APP_SECRET=change_me_to_a_random_64_char_string_for_production_use_please

# 3. Consider switching from SQLite to MySQL/PostgreSQL for better performance
#    with multiple concurrent users (see docker-compose.yml comments)

# 4. Set up regular backups of the partdb_data volume
# ===== END PRODUCTION CHANGES =====

# Currency settings
DEFAULT_CURRENCY=USD

# Database passwords (change these!)
DB_ROOT_PASSWORD=rootpassword123
DB_PASSWORD=partdbpassword123

# Email configuration
MAILER_DSN=smtp://mail.supported.systems:25
EMAIL_SENDER_EMAIL=noreply@${DOMAIN}
EMAIL_SENDER_NAME=Part-DB System
ALLOW_EMAIL_PW_RESET=1